<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KCHC.SettingsPage"
             Title="Settings">
    <Grid Padding="0">
        <Image x:Name="PageBackground"
               Source="kchcsettings.png"
               Aspect="AspectFill"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand"
               InputTransparent="True" />

        <ScrollView VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
            <Frame BackgroundColor="#CCFFFFFF"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="18"
                   Margin="16">
                <StackLayout Spacing="12">

                    <Label Text="Enable Intro Music"
                           FontSize="20"
                           TextColor="Black" />
                    <Switch x:Name="IntroMusicSwitch" />

                    <Label Text="Main Page Appearance"
                           FontSize="20"
                           TextColor="Black" />
                    <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                        <Label Text="Light"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="Black" />
                        <Switch x:Name="ModeSwitch" VerticalOptions="Center" />
                        <Label Text="Dark"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="Black" />
                    </StackLayout>

                    <Button Text="Save"
                            Clicked="OnSaveClicked"
                            FontSize="18"
                            TextColor="Black" />

                </StackLayout>
            </Frame>
        </ScrollView>
    </Grid>
</ContentPage>