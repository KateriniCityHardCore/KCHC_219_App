<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KCHC.SettingsPage"
             Title="Settings">
    <Grid Padding="0">
        <ScrollView VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
            <StackLayout Padding="20" Spacing="12">

                <Label Text="Enable Intro Music" />
                <Switch x:Name="IntroMusicSwitch" />

                <Label Text="Main Page Appearance" />
                <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                    <Label Text="Light" VerticalOptions="Center" />
                    <Switch x:Name="ModeSwitch" VerticalOptions="Center" />
                    <Label Text="Dark" VerticalOptions="Center" />
                </StackLayout>

                <Button Text="Save" Clicked="OnSaveClicked" />

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>